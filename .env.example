# Copy to .env and change the values: cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by both the db and web services)
POSTGRES_DB=simplerest
POSTGRES_USER=simplerest
POSTGRES_PASSWORD=change-me
